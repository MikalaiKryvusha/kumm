#!/bin/sh
# pre-commit — обязательство KUMM: опознаватели владельца и его машины не уезжают в репозиторий.
#
# Проверяются ИМЕННО ЗАКОММИЧЕННЫЕ файлы, а не весь репозиторий: гейт обязан ловить то, что ты
# отправляешь прямо сейчас, и делать это за доли секунды, иначе его начнут обходить.
#
# Включается один раз в клоне:  node tools/scrub-identity.mjs --install-hook
# (хук версионируется в репозитории, git его сам не подхватывает — нужен core.hooksPath)
#
# Обойти в исключительном случае:  git commit --no-verify
# Это оставлено намеренно, но каждый такой коммит — осознанное решение человека, а не забывчивость.

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node не найден — проверку на опознаватели выполнить нечем." >&2
  echo "Гейт БЛОКИРУЕТ коммит: молча пропустить проверку хуже, чем остановить работу." >&2
  exit 1
fi

# ACMR, не ACM: переименованный файл тоже уезжает с содержимым, и коммит из одних переименований не должен
# проходить мимо обоих гейтов (находка судьи 2026-09-18: `git mv` + правка пронесли и путь профиля, и штамп).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -c . || true)
if [ "$STAGED" -eq 0 ]; then exit 0; fi

if ! git diff --cached --name-only --diff-filter=ACMR -z \
   | xargs -0 -r node tools/scrub-identity.mjs --check; then
  echo "" >&2
  echo "КОММИТ ОСТАНОВЛЕН: в отправляемых файлах есть опознаватели." >&2
  echo "  автоматически:  node tools/scrub-identity.mjs --fix   (потом git add)" >&2
  echo "  вручную:        места «ручного» класса перепиши нейтрально — заглушка там сломает смысл" >&2
  exit 1
fi

# Второй гейт (2026-09-18, класс claim-before-evidence, EXP-0121): время впереди часов и отметка [TESTED: …]
# без существующего отчёта прогона. Судит только добавленные строки файлов проекта.
if ! node tools/check-claim-before-evidence.mjs --staged >&2; then
  echo "" >&2
  echo "КОММИТ ОСТАНОВЛЕН: утверждение записано раньше наблюдения (строки выше)." >&2
  echo "  время бери из часов: date '+%Y-%m-%d %H:%M %:z';  отметку [TESTED: …] ставь после прогона, с путём к его отчёту" >&2
  exit 1
fi

# Третий гейт (2026-10-10, слово владельца «как-то ты так замеряешь, что меня обманываешь(((»): отчёт прогона с замером кадра
# (`perf N`) говорит, жил ли мир — world=running|FROZEN из строки пульта или «Мир при замере: …». Самопроверка — --selftest.
if ! node tools/check-perf-world.mjs --staged >&2; then
  echo "" >&2
  echo "КОММИТ ОСТАНОВЛЕН: замер кадра без состояния мира (строки выше)." >&2
  echo "  часы игры стоят — расписания и «мозг» жителей не работают, их цена кажется нулевой (perf-series C7: 0.5 против 4.5 мс)" >&2
  exit 1
fi

# Четвёртый гейт (2026-11-10, KAIF #196): в своде правил (AGENT_GUIDE.md, HOUSE_RULES.md, CLAUDE.md) нет сырого голоса владельца —
# правило, а не цитата. Судит новые строки против HEAD. Тот же страж стоит хуком PreToolUse на Write/Edit; здесь он ловит то, что
# пришло мимо них (оболочка, скрипт обновления KAIF). Код 3 — поломка самого стража, не находка.
set +e
if [ -f tools/hooks/guide-no-raw-voice.mjs ]; then node tools/hooks/guide-no-raw-voice.mjs --staged >&2; rc=$?; else echo "guide-no-raw-voice.mjs not found" >&2; rc=3; fi
set -e
if [ "$rc" -eq 3 ]; then
  echo "" >&2
  echo "КОММИТ ОСТАНОВЛЕН: страж свода правил сломался (строка выше) — это поломка стража, не находка." >&2
  exit 1
elif [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "КОММИТ ОСТАНОВЛЕН: в своде правил дословные слова владельца или файл не в UTF-8 (строки выше)." >&2
  echo "  правило — утверждением по-английски + строка-адрес [OWNER] <дата> · <где слова>; слова — в PROJECT_HISTORY.md" >&2
  exit 1
fi

exit 0
